{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sukunlife.app/schemas/integrations/prescription_event.v1.json",
  "title": "CRM prescription event (v1)",
  "description": "Sent by the CRM backend only for FINAL, confirmed prescriptions. Drafts are never sent. There is deliberately no staff-only note field: internal notes stay in the CRM.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "occurred_at",
    "patient",
    "prescription",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "description": "Unique per event. Replays with the same content are safe."
    },
    "event_type": {
      "enum": [
        "prescription.issued",
        "prescription.updated",
        "prescription.cancelled"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "patient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crm_patient_id"
      ],
      "properties": {
        "crm_patient_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "crm_customer_id": {
          "type": "string",
          "maxLength": 128
        },
        "crm_family_id": {
          "type": "string",
          "maxLength": 128
        }
      }
    },
    "prescription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crm_prescription_id",
        "version"
      ],
      "properties": {
        "crm_prescription_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "description": "Strictly increasing per prescription. Older or equal versions are reported as stale and never applied."
        },
        "status": {
          "const": "issued"
        },
        "issued_at": {
          "type": "string",
          "format": "date-time"
        },
        "issued_by": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "crm_staff_id"
          ],
          "properties": {
            "crm_staff_id": {
              "type": "string"
            },
            "display_name": {
              "type": "string"
            }
          }
        },
        "timezone": {
          "type": "string",
          "description": "Informational. Reminder times are patient local time."
        },
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "patient_visible_note": {
          "type": "string",
          "maxLength": 4000,
          "description": "Shown to the patient as the prescription text. If absent, a list of the items is shown."
        },
        "cancellation_reason": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "prescription.cancelled"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "items": {
            "type": "array",
            "minItems": 1
          },
          "prescription": {
            "type": "object",
            "required": [
              "crm_prescription_id",
              "version",
              "start_date"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "template_id",
        "frequency",
        "reminder_times"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Unique inside the event."
        },
        "template_id": {
          "type": "string",
          "pattern": "^[a-z][0-9]{2}$"
        },
        "template_revision": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "description": "Optional pin. A mismatch is accepted but reported as a warning."
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "patient_instruction": {
          "type": "string",
          "maxLength": 2000,
          "description": "Overrides the template instruction for this patient only. The master template is never changed."
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "description": "Required when the instruction contains {বার}. Never guessed."
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "description": "Required when the instruction contains {মিনিট}."
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "description": "Required when the instruction contains {দিন}."
        },
        "frequency": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "daily"
                },
                "interval": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 365
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "weekdays"
              ],
              "properties": {
                "type": {
                  "const": "weekly"
                },
                "weekdays": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 7
                  },
                  "minItems": 1,
                  "uniqueItems": true,
                  "description": "ISO weekday, 1=Monday"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "dates"
              ],
              "properties": {
                "type": {
                  "const": "dates"
                },
                "dates": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "minItems": 1,
                  "maxItems": 120,
                  "uniqueItems": true
                },
                "ghusl": {
                  "enum": [
                    "nazar",
                    "boroi",
                    "detox"
                  ]
                }
              }
            }
          ]
        },
        "reminder_times": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
          },
          "maxItems": 8,
          "uniqueItems": true,
          "description": "Required, may be empty (no reminder). Never defaulted from the template."
        },
        "start_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "end_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "duration_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650,
          "description": "Sets end_date = start_date + duration_days - 1."
        },
        "resource_refs": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string"
          },
          "description": "Content slugs or quran:N. Defaults to the template's refs. Unpublished or staff-only items are skipped and reported."
        }
      }
    }
  }
}
