# Client-safe configuration only
SUPABASE_URL=
SUPABASE_ANON_KEY=
FIREBASE_PROJECT_ID=

# IMPORTANT:
# Do NOT put server-only secrets in the Flutter app environment.
# Store server-only values in Supabase/CI secret storage instead.
#
# The Prescription -> Action AI router uses four Gemini key slots.
# These are examples of SECRET NAMES only; do not commit real values.
#
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_MODEL=
# AI_KEY_COOLDOWN_SECONDS=3600
# AI_REQUEST_TIMEOUT_MS=25000
# AI_MAX_RETRY_PER_KEY=1
# SUPABASE_SERVICE_ROLE_KEY=
#
# See docs/AI_FAILOVER_ARCHITECTURE.md.
