# Client-safe configuration only
APP_ENVIRONMENT=development
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy compatibility only. Prefer SUPABASE_PUBLISHABLE_KEY.
# SUPABASE_ANON_KEY=
FIREBASE_PROJECT_ID=

# IMPORTANT:
# Do NOT put server-only secrets in the Flutter app environment.
# Store server-only values in Supabase/CI secret storage instead.
#
# The Prescription -> Action AI router uses four Gemini key slots.
# These are examples of SECRET NAMES only; do not commit real values.
#
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_API_KEY_4=
# GEMINI_MODEL=gemini-3.8-flash
# Set the same scope name for keys that share one provider project/quota pool.
# Unspecified scopes are conservatively treated as one shared quota.
# GEMINI_QUOTA_SCOPE_1=
# GEMINI_QUOTA_SCOPE_2=
# GEMINI_QUOTA_SCOPE_3=
# GEMINI_QUOTA_SCOPE_4=
# AI_KEY_COOLDOWN_SECONDS=3600
# AI_REQUEST_TIMEOUT_MS=25000
# AI_MAX_RETRY_PER_KEY=1
# SUPABASE_SERVICE_ROLE_KEY=
#
# See docs/AI_FAILOVER_ARCHITECTURE.md.
